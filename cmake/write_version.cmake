# Generates pyqcm/_version.py from git for a direct (non scikit-build) CMake build.
# Invoked at build time by the 'pyqcm_version' target (see CMakeLists.txt), so the
# version and commit hash are refreshed on every 'cmake --build', not only when
# CMake reconfigures. Mimics the format written by setuptools-scm.
#
# Required variables: SOURCE_DIR, OUTPUT

execute_process(
    COMMAND git describe --tags --long --dirty --always
    OUTPUT_VARIABLE GIT_DESCRIBE
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    WORKING_DIRECTORY ${SOURCE_DIR})

set(VERSION "unknown")
set(COMMIT_ID "unknown")
set(VERSION_TUPLE "()")

# e.g. v2.33.1-1-g7e26b0d or v2.33.1-1-g7e26b0d-dirty
if(GIT_DESCRIBE MATCHES "^v?([0-9]+)\\.([0-9]+)\\.([0-9]+)-([0-9]+)-(g[0-9a-f]+)(-dirty)?$")
    set(MAJ ${CMAKE_MATCH_1})
    set(MIN ${CMAKE_MATCH_2})
    set(PAT ${CMAKE_MATCH_3})
    set(DIST ${CMAKE_MATCH_4})
    set(COMMIT_ID ${CMAKE_MATCH_5})
    set(DIRTY ${CMAKE_MATCH_6})
    if(DIST EQUAL 0 AND NOT DIRTY)
        set(VERSION "${MAJ}.${MIN}.${PAT}")
        set(VERSION_TUPLE "(${MAJ}, ${MIN}, ${PAT})")
    else()
        # same convention as setuptools-scm: next patch, dev<distance>, local part
        math(EXPR PAT "${PAT} + 1")
        set(LOCAL "${COMMIT_ID}")
        if(DIRTY)
            string(TIMESTAMP TODAY "%Y%m%d")
            set(LOCAL "${LOCAL}.d${TODAY}")
        endif()
        set(VERSION "${MAJ}.${MIN}.${PAT}.dev${DIST}+${LOCAL}")
        set(VERSION_TUPLE "(${MAJ}, ${MIN}, ${PAT}, 'dev${DIST}', '${LOCAL}')")
    endif()
elseif(GIT_DESCRIBE MATCHES "^([0-9a-f]+)(-dirty)?$")
    # no tag reachable: only the hash is available
    set(COMMIT_ID "g${CMAKE_MATCH_1}")
endif()

set(CONTENT "# file generated by cmake/write_version.cmake (direct CMake build)
# don't change, don't track in version control
__all__ = [\"__version__\", \"__version_tuple__\", \"version\", \"version_tuple\", \"__commit_id__\", \"commit_id\"]

__version__ = version = '${VERSION}'
__version_tuple__ = version_tuple = ${VERSION_TUPLE}

__commit_id__ = commit_id = '${COMMIT_ID}'
")

# rewrite only if changed, to avoid needless timestamp updates
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} OLD_CONTENT)
endif()
if(NOT "${OLD_CONTENT}" STREQUAL "${CONTENT}")
    file(WRITE ${OUTPUT} "${CONTENT}")
    message(STATUS "pyqcm version ${VERSION} (${COMMIT_ID}) written to ${OUTPUT}")
endif()
